{
  "mcpServers": {
    "helpscout": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "HELPSCOUT_APP_ID": "${HELPSCOUT_APP_ID}",
        "HELPSCOUT_APP_SECRET": "${HELPSCOUT_APP_SECRET}",
        "HELPSCOUT_DEFAULT_INBOX_ID": "${HELPSCOUT_DEFAULT_INBOX_ID:-348804}",
        "AIRTABLE_PAT": "${AIRTABLE_PAT}"
      }
    }
  }
}